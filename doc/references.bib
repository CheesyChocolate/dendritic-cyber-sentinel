	urldate = {2024-11-18},
	date = {2008-03-17},
	file = {Accepted Version:/home/suren/.local/share/Zotero/storage/9VWD9MGY/Thomas et al. - 2008 - Usefulness of DARPA dataset for intrusion detection system evaluation.pdf:application/pdf},
}

